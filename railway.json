{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && python manage.py collectstatic --noinput && gunicorn config.wsgi --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

/* ----- Section titles ----- */
.section-title { text-align: center; margin-bottom: 2.5rem; }
.section-title p { color: var(--muted); max-width: 700px; margin: 0.5rem auto 0; }
.section-title::after {
  content: '';
  display: block;
  width: 120px;
  height: 6px;
  margin: 1rem auto 0;
  border-radius: 6px;
  background: linear-gradient(90deg, var(--red), var(--gold), var(--green));
  box-shadow: 0 3px 10px rgba(0,0,0,0.5);
}

/* ----- Grid ----- */
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.8rem; }

/* ----- Glass 3D cards ----- */
.card, .glass, .service-card, .product-card, .info-box {
  position: relative;
  padding: 1.8rem;
  border-radius: var(--radius);
  background: linear-gradient(145deg, var(--glass-strong), var(--glass));
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(16px) saturate(150%);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  box-shadow: var(--shadow-3d);
  transition: transform 0.45s cubic-bezier(.2,.8,.2,1), box-shadow 0.45s ease;
  overflow: hidden;
}
.card::before, .glass::before, .service-card::before, .product-card::before, .info-box::before {
  content: '';
  position: absolute;
  top: 0; left: -120%;
  width: 80%; height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.22), transparent);
  transform: skewX(-20deg);
  transition: left 0.9s ease;
}
.card:hover, .glass:hover, .service-card:hover, .product-card:hover, .info-box:hover {
  transform: translateY(-10px) rotateX(3deg) scale(1.02);
  box-shadow: 0 30px 60px rgba(0,0,0,0.65), 0 0 40px rgba(252,209,22,0.25), inset 0 1px 0 rgba(255,255,255,0.5), inset 0 -2px 6px rgba(0,0,0,0.35);
}
.card:hover::before, .glass:hover::before, .service-card:hover::before, .product-card:hover::before, .info-box:hover::before { left: 140%; }
.product-card img, .card img { border-radius: 16px; margin-bottom: 1rem; box-shadow: 0 10px 25px rgba(0,0,0,0.5); transition: transform 0.5s ease; }
.product-card:hover img, .card:hover img { transform: scale(1.05); }
.price { color: var(--gold); font-size: 1.4rem; font-weight: 700; }

/* ----- Embossed gold buttons ----- */
.btn, button, input[type=submit] {
  display: inline-block;
  padding: 0.85rem 2rem;
  border: none;
  border-radius: 999px;
  cursor: pointer;
  font-size: 1rem;
  font-weight: 700;
  color: #1a1204;
  background: linear-gradient(160deg, #ffe680, var(--gold) 45%, var(--gold-deep));
  box-shadow: 0 8px 0 #7a5a06, 0 14px 24px rgba(0,0,0,0.55), inset 0 2px 0 rgba(255,255,255,0.7);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.btn:hover, button:hover, input[type=submit]:hover { transform: translateY(-3px); box-shadow: 0 11px 0 #7a5a06, 0 18px 30px rgba(0,0,0,0.6), inset 0 2px 0 rgba(255,255,255,0.7); }
.btn:active, button:active, input[type=submit]:active { transform: translateY(6px); box-shadow: 0 2px 0 #7a5a06, 0 4px 8px rgba(0,0,0,0.5), inset 0 2px 0 rgba(255,255,255,0.5); }
.btn-red { color: #fff; background: linear-gradient(160deg, #ff5a6e, var(--red) 50%, #8a0b1a); box-shadow: 0 8px 0 #5c0711, 0 14px 24px rgba(0,0,0,0.55), inset 0 2px 0 rgba(255,255,255,0.4); }

/* ----- Forms (glass, inset) ----- */
form { display: grid; gap: 1.1rem; }
label { font-weight: 600; color: var(--gold); }
input, textarea, select {
  width: 100%;
  padding: 0.9rem 1.1rem;
  border-radius: 14px;
  border: 1px solid var(--glass-border);
  background: rgba(0,0,0,0.35);
  color: var(--text);
  font-size: 1rem;
  box-shadow: inset 0 4px 10px rgba(0,0,0,0.55), inset 0 -1px 0 rgba(255,255,255,0.12);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--gold); box-shadow: inset 0 4px 10px rgba(0,0,0,0.55), 0 0 0 4px rgba(252,209,22,0.25); }
.errorlist { list-style: none; color: #ff8a98; font-size: 0.9rem; }
.messages li { padding: 0.9rem 1.2rem; margin-bottom: 1rem; border-radius: 14px; background: rgba(0,107,63,0.35); border: 1px solid var(--green); box-shadow: var(--shadow-3d); }

/* ----- Footer ----- */
footer {
  margin-top: 3rem;
  padding: 2.5rem 0;
  text-align: center;
  color: var(--muted);
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(14px);
  border-top: 1px solid var(--glass-border);
  box-shadow: 0 -10px 30px rgba(0,0,0,0.5);
}
footer .motto { margin-top: 0; }
/* ----- Page-load fade in ----- */
main > section, .container > * { animation: fadeUp 0.9s ease both; }
main > section:nth-child(2) { animation-delay: 0.15s; }
main > section:nth-child(3) { animation-delay: 0.3s; }
main > section:nth-child(4) { animation-delay: 0.45s; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }

/* Cards drift in one after another */
.grid > * { animation: fadeUp 0.8s ease both; }
.grid > *:nth-child(2) { animation-delay: 0.12s; }
.grid > *:nth-child(3) { animation-delay: 0.24s; }
.grid > *:nth-child(4) { animation-delay: 0.36s; }
.grid > *:nth-child(5) { animation-delay: 0.48s; }
.grid > *:nth-child(6) { animation-delay: 0.6s; }

/* ----- Gentle floating star or logo ----- */
.float { animation: bob 5s ease-in-out infinite; }
@keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }

/* ----- Gold scroll bar ----- */
::-webkit-scrollbar { width: 12px; }
::-webkit-scrollbar-track { background: var(--night); }
::-webkit-scrollbar-thumb { background: linear-gradient(var(--red), var(--gold), var(--green)); border-radius: 10px; border: 2px solid var(--night); }
::selection { background: var(--gold); color: #1a1204; }

/* ----- Mobile ----- */
@media (max-width: 760px) {
  section { padding: 3rem 0; }
  .hero { padding: 4rem 0 3rem; }
  header .container, .site-header .container, nav.navbar .container { justify-content: center; }
  nav ul { justify-content: center; }
  .card:hover, .glass:hover, .service-card:hover, .product-card:hover, .info-box:hover { transform: translateY(-4px); }
}

/* ----- Respect people who prefer less motion ----- */
@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; }
}

